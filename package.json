{
  "name": "unotame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.scss\" --allow-empty-input && prettier --check .",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --allow-empty-input --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:watch": "vitest",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "destyle.css": "4.0.1",
    "microcms-js-sdk": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "node-html-parser": "^9.0.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
