---
// ローダー（トップだけ。layout.md）。見た目と時間は object/component/_loader.scss が持ち、ここでは状態クラスだけを付ける。
// JS が無効のときに出さないためのスタイルは、style 要素を head に置く必要があるので BaseLayout.astro の head にある。
// eslint-disable-next-line @typescript-eslint/no-unused-vars -- Astro が型チェックで参照する（props を受け取らないことを明示）
type Props = Record<string, never>;
---

<div class="c-loader" data-loader aria-hidden="true">
  <div class="c-loader__dot"></div>
</div>

<script>
  // 現行（jQuery）のタイミングを再現する: load 後にフェードアウトし、load が来なくても 5 秒で消す。
  const TIMEOUT_MS = 5000;
  // transitionend の取りこぼし対策（CSS の遅延＋時間より少し長く）
  const HIDE_AFTER_LOADED_MS = 1800;
  const HIDE_AFTER_TIMEOUT_MS = 700;

  const loader = document.querySelector<HTMLElement>('[data-loader]');

  if (loader) {
    let state: 'loading' | 'loaded' | 'timeout' = 'loading';

    const hide = () => {
      loader.hidden = true;
    };

    loader.addEventListener('transitionend', (event) => {
      if (event.target === loader && event.propertyName === 'opacity') hide();
    });

    const finish = (next: 'loaded' | 'timeout', hideAfterMs: number) => {
      if (state !== 'loading') return;
      state = next;
      loader.classList.add(next === 'loaded' ? 'is-loaded' : 'is-timeout');
      window.setTimeout(hide, hideAfterMs);
    };

    if (document.readyState === 'complete') {
      finish('loaded', HIDE_AFTER_LOADED_MS);
    } else {
      window.addEventListener('load', () => finish('loaded', HIDE_AFTER_LOADED_MS), {
        once: true,
      });
    }
    window.setTimeout(() => finish('timeout', HIDE_AFTER_TIMEOUT_MS), TIMEOUT_MS);
  }
</script>
