---
import { site } from '../../data/site';
import { resolveAriaCurrent } from '../../lib/navigation';
import { routes } from '../../lib/routes';

type Props = {
  /** aria-current の判定用（BaseLayout が Astro.url.pathname を渡す） */
  pathname: string;
};

const { pathname } = Astro.props;
const contactHref = routes.contact();
---

<footer class="l-footer">
  <section class="l-footer-contact">
    <a href={contactHref} aria-current={resolveAriaCurrent(contactHref, pathname)}>
      <h2>CONTACT</h2>
    </a>
  </section>
  <div class="l-footer-copy">
    <span>{site.copyright}</span>
  </div>
</footer>
