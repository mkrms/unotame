---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo-landscape.png';
import { globalNav } from '../../data/navigation';
import { resolveAriaCurrent } from '../../lib/navigation';
import { routes } from '../../lib/routes';

type Props = {
  /** aria-current の判定用（BaseLayout が Astro.url.pathname を渡す） */
  pathname: string;
};

const { pathname } = Astro.props;
---

<header class="l-header">
  <a href={routes.home()} class="l-header__logo">
    <Image class="l-header__logo-img" src={logo} alt="UNOTAME" loading="eager" />
  </a>
  <nav class="l-header__nav" aria-label="メイン">
    <ul class="l-header__nav__list">
      {globalNav.map((item) => (
        <li class="l-header__nav__list__item">
          <a
            class="l-header__nav__list__item-link"
            href={item.href}
            aria-current={resolveAriaCurrent(item.href, pathname)}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
